rules_version = '2';
// NEXUS — Firestore security rules (one file for the whole platform).
// Deploy:  firebase deploy --only firestore:rules
// Ownership, visibility and every counter are enforced HERE, on the
// server — the browser code is never trusted to police itself.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()      { return request.auth != null; }
    function me()            { return request.auth.uid; }
    function incoming()      { return request.resource.data; }
    function existing()      { return resource.data; }
    function isOwner(d)      { return signedIn() && me() == d.ownerId; }
    function isAuthor(d)     { return signedIn() && me() == d.authorId; }
    function validVis(v)     { return v in ['public', 'unlisted', 'private']; }
    // who a game / app is for: 3+ · 7+ · 12+ · 16+ · 18+ (none = everyone)
    function validAge(d)     { return !('ageRating' in d) || d.ageRating in ['3', '7', '12', '16', '18']; }
    // the player's age, from the birth month their account gave once (ages/{uid})
    function hasAccount()    { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function yearsOld() {
      let b = get(/databases/$(database)/documents/ages/$(request.auth.uid)).data;
      return request.time.year() - b.y - (request.time.month() < b.m ? 1 : 0);
    }
    // may this player run something rated r? 3+ is for everyone (guests too);
    // above that: an account whose birth month makes them old enough
    function ageAllows(r)    { return r == '3' || (hasAccount() && exists(/databases/$(database)/documents/ages/$(request.auth.uid)) && yearsOld() >= int(r)); }
    function onlyChanged(ks) { return incoming().diff(existing()).affectedKeys().hasOnly(ks); }
    // a counter may move by exactly 'by', and nothing else in the doc may change
    function bumped(f, by)   { return incoming()[f] == existing()[f] + by && onlyChanged([f]); }
    // A game published from a guest (anonymous) session moves to the account
    // the player signs in to: just before signing in, the guest session (the
    // owner) seals the doc with the SHA-256 of a one-time secret that only
    // that page holds; right after, the account presents the secret. Whoever
    // has it takes the doc over — once (the seal is removed in the same write).
    function claimedWith(ks) {
      return signedIn() && existing().get('claim', null) is map && incoming().ownerId == me()
             && incoming().get('claimKey', null) is string && incoming().claimKey.size() == 64
             && hashing.sha256(incoming().claimKey).toHexString().lower() == existing().claim.h
             && !('claim' in incoming()) && onlyChanged(ks);
    }

    // ---------------------------------------------------------------- team roles
    // A project has ONE owner (ownerId) and a team {uid: role}:
    //   developer — scripts / code          builder — scene + assets
    //   tester    — run and test the game    viewer  — read only
    // Every check below runs on the server; hiding a button in the app is
    // never what stops a member from doing something their role forbids.
    function projectPath(pid) { return /databases/$(database)/documents/projects/$(pid); }
    function roleIn(d)        { return d.ownerId == me() ? 'owner' : d.get('members', {}).get(me(), ''); }
    function roleIs(pid, rs)  { return signedIn() && pid is string && exists(projectPath(pid)) && roleIn(get(projectPath(pid)).data) in rs; }
    function memberOf(pid)    { return roleIs(pid, ['owner', 'developer', 'builder', 'tester', 'viewer']); }
    function workerOf(pid)    { return roleIs(pid, ['owner', 'developer', 'builder', 'tester']); }
    function ROLES()          { return ['developer', 'builder', 'tester', 'viewer']; }
    function textOk(v, n)     { return v is string && v.size() <= n; }

    // Nothing is readable or writable unless a rule below says so (Firestore
    // denies by default). There is NO "allow read, write: if true" anywhere.

    // boot-time connectivity probe (read-only, holds no data)
    match /_nexus/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------- assets
    match /assets/{assetId} {
      // public + unlisted by id; private only for the owner
      allow get:  if resource == null || existing().visibility in ['public', 'unlisted'] || isOwner(existing());
      // discovery lists only public; the owner lists their own
      allow list: if existing().visibility == 'public' || isOwner(existing());
      allow create: if signedIn() && incoming().ownerId == me() && incoming().assetId == assetId
                    && incoming().usageCount == 0 && validVis(incoming().visibility);
      allow update: if (isOwner(existing()) && incoming().ownerId == existing().ownerId
                        && incoming().usageCount == existing().usageCount && validVis(incoming().visibility))
                    || (signedIn() && bumped('usageCount', 1));
      allow delete: if isOwner(existing());
    }

    // ---------------------------------------------------------------- projects (private to the owner and the team)
    match /projects/{projectId} {
      // what each role may change — anything else in the record is the owner's
      function CODE()   { return ['files', 'scripts', 'components', 'deps', 'fileFolders']; }
      function SCENE()  { return ['scene', 'assetRefs', 'assetFolders']; }
      function SHARED() { return ['i18n', 'aiMemory', 'history', 'updatedAt', 'updatedBy', 'rev', 'lastEdit']; }
      function team(d)  { return d.get('memberIds', []); }
      function inTeam(d) { return signedIn() && me() in team(d); }
      function changed() { return incoming().diff(existing()).affectedKeys(); }
      // every content change moves the revision by exactly one: two people
      // saving over the same revision cannot both win — the second one is
      // refused and has to merge (Studio shows the conflict)
      function nextRev() { return incoming().get('rev', 0) == existing().get('rev', 0) + 1; }
      function revOk()   { return !changed().hasAny(CODE().concat(SCENE()).concat(['i18n'])) || nextRev() || team(existing()).size() == 0; }
      function validTeam() {
        return incoming().get('members', {}).values().hasOnly(ROLES())
          && incoming().get('members', {}).keys().toSet() == team(incoming()).toSet()
          && team(incoming()).size() <= 30
          && !(incoming().ownerId in team(incoming()));
      }
      // nobody is added to a team by someone else: a member joins only by
      // accepting their own invitation (see joining())
      function noNewMembers() { return team(incoming()).toSet().difference(team(existing()).toSet()).size() == 0; }

      function ownerEdit() {
        return isOwner(existing()) && incoming().ownerId == existing().ownerId
          && validTeam() && noNewMembers() && revOk();
      }
      // ownership goes to someone already in the team; the old owner may stay
      // on as a member or leave
      function transfer() {
        return isOwner(existing()) && incoming().ownerId != existing().ownerId
          && incoming().ownerId in team(existing())
          && validTeam()
          && team(incoming()).toSet().difference(team(existing()).toSet()).hasOnly([me()])
          && changed().hasOnly(['ownerId', 'ownerName', 'members', 'memberIds', 'memberNames', 'updatedAt']);
      }
      function memberEdit() {
        let r = roleIn(existing());
        return (r == 'developer' || r == 'builder') && inTeam(existing())
          && nextRev() && incoming().get('updatedBy', '') == me()
          && changed().hasOnly((r == 'developer' ? CODE() : SCENE()).concat(SHARED()));
      }
      function invitePath() { return /databases/$(database)/documents/invites/$(projectId + '__' + request.auth.uid); }
      function joining() {
        return signedIn() && !(me() in team(existing())) && existing().ownerId != me()
          && exists(invitePath())
          && get(invitePath()).data.status == 'pending'
          && getAfter(invitePath()).data.status == 'accepted'
          && changed().hasOnly(['members', 'memberIds', 'memberNames'])
          && incoming().members.diff(existing().get('members', {})).affectedKeys().hasOnly([me()])
          && incoming().members[me()] == get(invitePath()).data.role
          && team(incoming()).toSet().difference(team(existing()).toSet()).hasOnly([me()])
          && team(existing()).toSet().difference(team(incoming()).toSet()).size() == 0
          && team(incoming()).size() <= 30
          && incoming().get('memberNames', {}).diff(existing().get('memberNames', {})).affectedKeys().hasOnly([me()]);
      }
      function leaving() {
        return inTeam(existing())
          && changed().hasOnly(['members', 'memberIds', 'memberNames'])
          && !(me() in team(incoming()))
          && !(me() in incoming().get('members', {}))
          && incoming().get('members', {}).diff(existing().get('members', {})).affectedKeys().hasOnly([me()])
          && team(existing()).toSet().difference(team(incoming()).toSet()).hasOnly([me()])
          && team(incoming()).toSet().difference(team(existing()).toSet()).size() == 0
          && incoming().get('memberNames', {}).diff(existing().get('memberNames', {})).affectedKeys().hasOnly([me()]);
      }

      allow get:    if resource == null || isOwner(existing()) || inTeam(existing());
      allow list:   if isOwner(existing()) || inTeam(existing());
      allow create: if signedIn() && incoming().ownerId == me() && incoming().projectId == projectId
                    && team(incoming()).size() == 0 && incoming().get('members', {}).size() == 0;
      allow update: if ownerEdit() || transfer() || memberEdit() || joining() || leaving();
      allow delete: if resource == null || isOwner(existing());

      // who is in the Studio now, what they are working on, their voice state
      match /presence/{uid} {
        allow read:           if memberOf(projectId);
        allow create, update: if memberOf(projectId) && uid == me() && incoming().uid == me()
                              && incoming().at == request.time && textOk(incoming().get('working', ''), 120);
        allow delete:         if signedIn() && (uid == me() || roleIs(projectId, ['owner']));
      }
      // the owner can mute someone for the whole team (every client obeys it)
      match /moderation/{uid} {
        allow read:           if memberOf(projectId);
        allow create, update: if roleIs(projectId, ['owner']) && incoming().by == me() && uid != me();
        allow delete:         if signedIn() && (uid == me() || roleIs(projectId, ['owner']));
      }
      // WebRTC voice signalling between team members — nothing else; no audio
      // ever passes through here (audio goes peer to peer and is never stored)
      match /signals/{sid} {
        allow read:   if signedIn() && existing().to == me() && memberOf(projectId);
        allow create: if memberOf(projectId) && incoming().from == me() && incoming().to is string
                      && (incoming().to == get(projectPath(projectId)).data.ownerId
                          || incoming().to in get(projectPath(projectId)).data.get('memberIds', []));
        allow delete: if signedIn() && (existing().to == me() || existing().from == me());
      }
      // the activity feed: append-only, written as yourself, at the server's time
      match /activity/{aid} {
        allow read:   if memberOf(projectId);
        allow create: if memberOf(projectId) && incoming().uid == me() && incoming().at == request.time
                      && textOk(incoming().action, 60) && textOk(incoming().get('target', ''), 160);
        allow delete: if roleIs(projectId, ['owner']);
      }
      // bug numbers (#1, #2 …) come from one counter that only moves by one,
      // in the same write as the bug it numbers
      match /meta/{doc} {
        allow read:   if memberOf(projectId);
        allow create: if workerOf(projectId) && doc == 'counters' && incoming().keys().hasOnly(['bugs']) && incoming().bugs == 1
                      && existsAfter(/databases/$(database)/documents/projects/$(projectId)/bugs/b1);
        allow update: if workerOf(projectId) && doc == 'counters' && bumped('bugs', 1)
                      && existsAfter(/databases/$(database)/documents/projects/$(projectId)/bugs/$('b' + string(incoming().bugs)));
      }
      match /bugs/{bid} {
        function bugOk(d) {
          return d.status in ['open', 'progress', 'fixed', 'closed'] && d.priority in ['low', 'medium', 'high', 'critical']
            && textOk(d.title, 140) && d.title.size() > 0 && textOk(d.get('desc', ''), 2000)
            && (d.get('assignee', null) == null || d.assignee is string);
        }
        allow read:   if memberOf(projectId);
        allow create: if workerOf(projectId) && incoming().by == me() && bugOk(incoming())
                      && incoming().status == 'open' && bid == 'b' + string(incoming().num)
                      && getAfter(/databases/$(database)/documents/projects/$(projectId)/meta/counters).data.bugs == incoming().num;
        allow update: if workerOf(projectId) && bugOk(incoming())
                      && changed().hasOnly(['title', 'desc', 'status', 'priority', 'assignee', 'assigneeName', 'updatedAt', 'updatedBy']);
        allow delete: if roleIs(projectId, ['owner']) || (signedIn() && existing().by == me());
      }
      // comments on a line of code or on an object in the scene
      match /comments/{cid} {
        allow read:   if memberOf(projectId);
        allow create: if workerOf(projectId) && incoming().by == me() && incoming().at == request.time
                      && incoming().resolved == false && textOk(incoming().text, 1000) && incoming().text.size() > 0
                      && incoming().target is map && incoming().target.kind in ['file', 'object'];
        allow update: if workerOf(projectId) && (
                           (existing().by == me() && changed().hasOnly(['text', 'editedAt']) && textOk(incoming().text, 1000))
                        || (changed().hasOnly(['resolved', 'resolvedBy', 'resolvedAt']) && incoming().resolved is bool));
        allow delete: if signedIn() && (existing().by == me() || roleIs(projectId, ['owner']));
      }
      // the task board — TODO / IN PROGRESS / DONE
      match /tasks/{tid} {
        function taskOk(d) { return d.status in ['todo', 'doing', 'done'] && textOk(d.title, 140) && d.title.size() > 0 && textOk(d.get('desc', ''), 1000); }
        allow read:   if memberOf(projectId);
        allow create: if roleIs(projectId, ['owner', 'developer', 'builder']) && incoming().by == me() && taskOk(incoming());
        allow update: if taskOk(incoming()) && incoming().by == existing().by && (
                           (roleIs(projectId, ['owner', 'developer', 'builder'])
                              && changed().hasOnly(['title', 'desc', 'status', 'assignee', 'assigneeName', 'order', 'updatedAt', 'updatedBy']))
                        || (signedIn() && existing().get('assignee', '') == me() && changed().hasOnly(['status', 'updatedAt', 'updatedBy'])));
        allow delete: if roleIs(projectId, ['owner']) || (signedIn() && existing().by == me());
      }
      // a TEAM PLAYTEST session (private: the room it uses is team-only, see /rooms)
      match /playtests/{sid} {
        allow read:   if memberOf(projectId);
        allow create: if workerOf(projectId) && incoming().hostId == me() && incoming().status == 'open';
        allow update: if signedIn() && existing().hostId == me() && incoming().hostId == me();
        allow delete: if signedIn() && (existing().hostId == me() || roleIs(projectId, ['owner']));
      }
    }
    match /checkpoints/{id} {
      allow get:    if resource == null || isOwner(existing());
      allow create: if signedIn() && incoming().ownerId == me();
      allow update: if isOwner(existing()) && incoming().ownerId == existing().ownerId;
      allow delete: if resource == null || isOwner(existing());
    }

    // ---------------------------------------------------------------- published games
    // PUBLIC games are readable by everyone — signed in or not, owner or
    // not. That is what lets phone B see what phone A published. The read
    // rule never requires ownerId == request.auth.uid for a public game.
    match /games/{gameId} {
      function validGame(d) { return d.title is string && d.title.size() > 0 && d.title.size() <= 120
                                     && d.gameId == gameId && validVis(d.visibility) && validAge(d); }
      allow get:  if resource == null || existing().visibility in ['public', 'unlisted'] || isOwner(existing());
      allow list: if existing().visibility == 'public' || isOwner(existing());
      allow create: if signedIn() && incoming().ownerId == me() && validGame(incoming())
                    && incoming().plays == 0 && incoming().likes == 0;
      allow update: if (isOwner(existing()) && incoming().ownerId == existing().ownerId && validGame(incoming())
                        && incoming().plays == existing().plays && incoming().likes == existing().likes
                        && incoming().createdAt == existing().createdAt)
                    || (signedIn() && bumped('plays', 1))
                    || (signedIn() && bumped('likes', 1)
                        && existsAfter(/databases/$(database)/documents/games/$(gameId)/likes/$(request.auth.uid))
                        && !exists(/databases/$(database)/documents/games/$(gameId)/likes/$(request.auth.uid)))
                    || (signedIn() && bumped('likes', -1)
                        && !existsAfter(/databases/$(database)/documents/games/$(gameId)/likes/$(request.auth.uid))
                        && exists(/databases/$(database)/documents/games/$(gameId)/likes/$(request.auth.uid)))
                    || claimedWith(['ownerId', 'creatorName', 'projectId', 'claim', 'claimKey', 'updatedAt']);
      allow delete: if resource == null || isOwner(existing());

      // one marker per (user, session); markers are never overwritten
      match /plays/{playId} {
        allow get:    if signedIn() && playId.split('_')[0] == me();
        allow create: if signedIn() && playId.split('_')[0] == me() && incoming().uid == me();
      }
      match /likes/{uid} {
        allow get:            if signedIn() && me() == uid;
        allow create, delete: if signedIn() && me() == uid;
      }

      function gameDoc()      { return get(/databases/$(database)/documents/games/$(gameId)).data; }
      function gameReadable() { return gameDoc().visibility in ['public', 'unlisted'] || isOwner(gameDoc()); }
      // analytics are read by the owner and the project's developers only
      function statsReader()  { return signedIn() && (isOwner(gameDoc()) || roleIs(gameDoc().get('projectId', null), ['owner', 'developer'])); }

      // ------------------------------------------------ leaderboard
      // One best score per player. The browser is never trusted with it: the
      // game's owner sets the ceiling and the fastest rate a real session can
      // reach (points per second since the session began at the SERVER's
      // clock); a score no real session could reach is refused here.
      // 'time' boards: lower is better, and a time can never be shorter than
      // the session that produced it.
      function lb()          { return gameDoc().get('leaderboard', {}); }
      function sessionPath() { return /databases/$(database)/documents/games/$(gameId)/lbSessions/$(request.auth.uid); }
      function elapsed()     { return (request.time - get(sessionPath()).data.startedAt).seconds(); }
      function scoreOk() {
        return lb().get('enabled', false) == true
          && incoming().keys().hasOnly(['uid', 'name', 'score', 'at'])
          && incoming().uid == me() && incoming().at == request.time
          && textOk(incoming().name, 40)
          && incoming().score is number && incoming().score >= 0
          && exists(sessionPath())
          && (lb().get('order', 'desc') == 'asc'
                ? (incoming().score >= lb().get('min', 0) && incoming().score <= elapsed() + 1)
                : (incoming().score <= lb().get('max', 1000000) && incoming().score <= (elapsed() + 1) * lb().get('perSecond', 100)));
      }
      function better() {
        return lb().get('order', 'desc') == 'asc' ? incoming().score < existing().score : incoming().score > existing().score;
      }
      match /scores/{uid} {
        allow read:   if gameReadable();
        allow create: if signedIn() && uid == me() && scoreOk();
        allow update: if signedIn() && uid == me() && scoreOk() && better();
        allow delete: if signedIn() && (uid == me() || isOwner(gameDoc()));
      }
      match /lbSessions/{uid} {
        allow get:            if signedIn() && uid == me();
        allow create, update: if signedIn() && uid == me() && incoming().keys().hasOnly(['startedAt']) && incoming().startedAt == request.time;
      }

      // ------------------------------------------------ analytics
      // One anonymous record per play session: no account id, no name, no
      // e-mail — 'pid' is a random id this device made for itself.
      match /analytics/{sid} {
        allow read:   if statsReader();
        allow create: if signedIn() && incoming().at == request.time
                      && incoming().keys().hasOnly(['at', 'day', 'dur', 'errors', 'errorSamples', 'fps', 'loadMs', 'device', 'mp', 'pid', 'v'])
                      && incoming().dur is number && incoming().dur >= 0 && incoming().dur <= 21600
                      && incoming().errors is int && incoming().errors >= 0 && incoming().errors <= 100000
                      && textOk(incoming().pid, 40) && textOk(incoming().day, 10)
                      && incoming().device in ['mobile', 'tablet', 'desktop']
                      && incoming().get('errorSamples', []).size() <= 3;
      }
      // players online now: a heartbeat with nothing in it but the time
      match /live/{sid} {
        allow read:           if statsReader();
        allow create, update: if signedIn() && incoming().keys().hasOnly(['at']) && incoming().at == request.time;
        allow delete:         if signedIn();
      }
      // multiplayer rooms that are running now — what a spectator can pick from
      match /rooms/{name} {
        allow read:           if gameReadable();
        allow create, update: if signedIn() && gameReadable() && incoming().keys().hasOnly(['name', 'players', 'at'])
                              && incoming().name == name && incoming().at == request.time
                              && incoming().players is int && incoming().players >= 0 && incoming().players <= 64;
      }
    }
    // the runnable snapshot of a game follows the game's visibility; only the
    // owner of the game record may write it (getAfter also works in a batch)
    match /builds/{gameId} {
      // the runnable game: only for players the game's age rating allows
      allow get: if resource == null || isOwner(existing())
                 || (get(/databases/$(database)/documents/games/$(gameId)).data.visibility in ['public', 'unlisted']
                     && ageAllows(get(/databases/$(database)/documents/games/$(gameId)).data.get('ageRating', '3')));
      allow create: if signedIn() && incoming().ownerId == me() && incoming().gameId == gameId
                    && getAfter(/databases/$(database)/documents/games/$(gameId)).data.ownerId == me();
      allow update: if (isOwner(existing()) && incoming().ownerId == me() && incoming().gameId == gameId)
                    || claimedWith(['ownerId', 'claim', 'claimKey', 'updatedAt']);
      allow delete: if resource == null || isOwner(existing());
    }

    // ---------------------------------------------------------------- the owner's AI key box
    // Written and read ONLY by the site's server function (service account,
    // netlify/edge-functions/ai.js). No browser — the owner's included — can
    // read a key back.
    match /platformSecrets/{doc} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- the API key pool (donated keys)
    // Players donate their own AI keys for the site's free AI. A key is
    // written ONCE from the browser and can never be read back by anyone —
    // not the donor, not another player, not a bot. Only the server code
    // (functions/index.js «processRequest», or the Netlify function with a
    // service account) reads it, with the admin SDK, which these rules do
    // not bind. Each account has five slots: "<uid>_0" … "<uid>_4" (so
    // nobody can flood the pool); the donor may withdraw their own key.
    match /api_keys/{keyId} {
      function poolKey(k) {
        return k is string && k.size() >= 20 && k.size() <= 200
               && k.matches('(AIza[0-9A-Za-z_-]+|AQ[.][0-9A-Za-z_.-]+|gsk_[A-Za-z0-9]+|sk-or-[A-Za-z0-9_-]+)');
      }
      // the key's SHA-256, computed HERE from the key itself: a key already in
      // the pool (api_key_hashes/<hash>) cannot be given again, by anyone
      function keyHash()   { return hashing.sha256(incoming().key).toHexString().lower(); }
      allow read: if false;
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && keyId.matches(me() + '_[0-4]')
                    && incoming().keys().hasAll(['key', 'createdAt', 'status', 'failCount', 'donorUid', 'keyHash'])
                    && incoming().keys().hasOnly(['key', 'createdAt', 'status', 'failCount', 'donorUid', 'provider', 'keyHash'])
                    && poolKey(incoming().key)
                    && incoming().keyHash == keyHash()
                    && !exists(/databases/$(database)/documents/api_key_hashes/$(keyHash()))
                    && getAfter(/databases/$(database)/documents/api_key_hashes/$(keyHash())).data.slot == keyId
                    && incoming().createdAt == request.time
                    && incoming().status == 'active'
                    && incoming().failCount == 0
                    && incoming().donorUid == me()
                    && (!('provider' in incoming()) || incoming().provider in ['gemini', 'groq', 'openrouter']);
      allow update: if false;
      allow delete: if signedIn() && existing().donorUid == me();
    }
    // one document per donated key's SHA-256 (never the key): written in the
    // same batch as the key; anyone signed in may ask «is this hash taken?»
    match /api_key_hashes/{h} {
      allow get: if signedIn();
      allow create: if hasAccount() && incoming().keys().hasOnly(['slot', 'donorUid', 'at'])
                    && incoming().donorUid == me() && incoming().slot.matches(me() + '_[0-4]')
                    && incoming().at == request.time
                    && getAfter(/databases/$(database)/documents/api_keys/$(incoming().slot)).data.keyHash == h;
      allow delete: if signedIn() && existing().donorUid == me();
      allow list, update: if false;
    }

    // ---------------------------------------------------------------- points (PART 34)
    // The balance, its history, the AI counter: written ONLY by the site's
    // server (netlify/edge-functions/points.js and ai.js, with the service
    // account — rules do not bind it). A browser can read its own, never write.
    match /wallets/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list, write: if false;
      match /ledger/{id} {
        allow read: if signedIn() && me() == uid;
        allow write: if false;
      }
    }
    match /usage/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list, write: if false;
    }
    // hosted files (direct links): created by the server after it charged the
    // points; anyone with the link can open the record, the owner lists and deletes
    match /files/{fileId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerId == me();
      allow delete: if signedIn() && existing().ownerId == me();
      allow create, update: if false;
    }
    // minutes others played each game (the creator earns points per 10 minutes)
    match /playtime/{gameId} {
      allow get: if true;
      allow list, write: if false;
    }
    // the server's own bookkeeping: ad sessions, AdMob transactions, upload
    // tickets, play marks, Stripe events — no browser reads or writes them
    match /ad_sessions/{id}     { allow read, write: if false; }
    match /ad_tx/{id}           { allow read, write: if false; }
    match /hosting_tickets/{id} { allow read, write: if false; }
    match /play_marks/{id}      { allow read, write: if false; }
    match /stripe_events/{id}   { allow read, write: if false; }
    match /stripe_subs/{id}     { allow read, write: if false; }

    // the pool's per-player request counter — server only
    match /api_usage/{uid} {
      allow read, write: if false;
    }

    // A player's birth month (year + month — never the day), given once.
    // Only they can read it; nobody can change or delete it from a browser
    // (a mistake is corrected by the site owner in the Firebase console).
    // Games and apps above 3+ are checked against it here and in storage.rules.
    match /ages/{uid} {
      allow get: if signedIn() && me() == uid;
      allow create: if hasAccount() && me() == uid
                    && incoming().keys().hasAll(['y', 'm', 'at']) && incoming().keys().hasOnly(['y', 'm', 'at'])
                    && incoming().y is int && incoming().m is int
                    && incoming().m >= 1 && incoming().m <= 12
                    && incoming().y >= request.time.year() - 120
                    && (incoming().y < request.time.year()
                        || (incoming().y == request.time.year() && incoming().m <= request.time.month()))
                    && incoming().at == request.time;
      allow list, update, delete: if false;
    }

    // ---------------------------------------------------------------- HTML apps & websites
    // The owner's own pages / sites (the files live in the file host as one
    // ZIP; this is the record). They run in a sandboxed opaque-origin frame.
    // A real account (not a guest session) owns them; anyone may count an open.
    match /apps/{appId} {
      function account()    { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      function validApp(d)  { return d.appId == appId && d.name is string && d.name.size() > 0 && d.name.size() <= 80
                                     && d.description is string && d.description.size() <= 2000 && validVis(d.visibility)
                                     && d.entry is string && d.entry.size() <= 300 && d.bundle is map && d.bundle.path is string
                                     && d.files is int && d.files > 0 && d.files <= 800
                                     && d.bytes is int && d.bytes <= 26214400 && validAge(d); }
      allow get:    if resource == null || existing().visibility in ['public', 'unlisted'] || isOwner(existing());
      allow list:   if existing().visibility == 'public' || isOwner(existing());
      allow create: if account() && incoming().ownerId == me() && validApp(incoming()) && incoming().opens == 0;
      allow update: if (isOwner(existing()) && incoming().ownerId == me() && validApp(incoming())
                        && incoming().opens == existing().opens && incoming().createdAt == existing().createdAt)
                    || (signedIn() && bumped('opens', 1));
      allow delete: if resource == null || isOwner(existing());
    }

    // ---------------------------------------------------------------- game saves (per player)
    match /saves/{id} {
      allow get:    if resource == null || (signedIn() && existing().uid == me());
      allow create: if signedIn() && incoming().uid == me();
      allow update: if signedIn() && existing().uid == me() && incoming().uid == me();
      allow delete: if signedIn() && existing().uid == me();
    }

    // ---------------------------------------------------------------- multiplayer rooms + WebRTC signalling
    // A TEAM PLAYTEST room ("pt--<projectId>--…") is private to that project's
    // team: members watch, everyone but viewers plays. Other rooms: any
    // signed-in player.
    match /rooms/{roomId} {
      function teamRoom() { return roomId.matches('pt--.+'); }
      function roomPid()  { return roomId.split('--')[1]; }
      function canSee()   { return signedIn() && (!teamRoom() || memberOf(roomPid())); }
      function canPlay()  { return signedIn() && (!teamRoom() || workerOf(roomPid())); }
      match /peers/{uid} {
        allow read: if canSee();
        allow create, update, delete: if canPlay() && me() == uid;
      }
      match /messages/{mid} {
        allow read:   if canSee();
        allow create: if canPlay() && incoming().from == me();
      }
      match /signals/{sid} {
        allow read:   if canSee() && existing().to == me();
        allow create: if canPlay() && incoming().from == me();
      }
    }

    // ---------------------------------------------------------------- replays (multiplayer sessions)
    // a recording belongs to whoever made it; one made in a team playtest is
    // readable by that project's team. Size and length are capped here.
    match /replays/{rid} {
      allow get:    if resource == null || isOwner(existing()) || existing().visibility == 'unlisted'
                    || memberOf(existing().get('projectId', null));
      allow list:   if isOwner(existing()) || memberOf(existing().get('projectId', null));
      allow create: if signedIn() && incoming().ownerId == me() && incoming().replayId == rid
                    && incoming().visibility in ['private', 'unlisted']
                    && incoming().data is string && incoming().data.size() <= 900000
                    && incoming().duration is number && incoming().duration <= 300
                    && (incoming().get('projectId', null) == null || memberOf(incoming().projectId));
      allow update: if isOwner(existing()) && onlyChanged(['title', 'visibility']) && incoming().visibility in ['private', 'unlisted'];
      allow delete: if isOwner(existing());
    }

    // ---------------------------------------------------------------- team invitations
    // "<projectId>__<uid>": only the project's owner invites; only the
    // invited person accepts (in the same write that adds them to the team)
    // or declines.
    match /invites/{iid} {
      allow get:    if signedIn() && (resource == null || existing().toId == me() || existing().fromId == me()
                                      || roleIs(existing().projectId, ['owner']));
      allow list:   if signedIn() && (existing().toId == me() || existing().fromId == me());
      allow create: if signedIn() && incoming().fromId == me() && incoming().toId is string && incoming().toId != me()
                    && iid == incoming().projectId + '__' + incoming().toId
                    && roleIs(incoming().projectId, ['owner'])
                    && !(incoming().toId in get(projectPath(incoming().projectId)).data.get('memberIds', []))
                    && incoming().role in ROLES() && incoming().status == 'pending'
                    && textOk(incoming().get('projectName', ''), 120);
      allow update: if signedIn() && (
           (existing().toId == me() && existing().status == 'pending'
              && onlyChanged(['status', 'answeredAt'])
              && (incoming().status == 'declined'
                  || (incoming().status == 'accepted'
                      && getAfter(projectPath(existing().projectId)).data.get('members', {}).get(me(), '') == existing().role)))
        || (existing().fromId == me() && incoming().fromId == me() && roleIs(existing().projectId, ['owner'])
              && incoming().toId == existing().toId && incoming().projectId == existing().projectId
              && incoming().status == 'pending' && incoming().role in ROLES()
              && !(incoming().toId in get(projectPath(incoming().projectId)).data.get('memberIds', []))));
      allow delete: if signedIn() && (existing().toId == me() || existing().fromId == me());
    }

    // ---------------------------------------------------------------- creator profiles
    match /users/{uid} {
      function slotAfter(i) { return existsAfter(/databases/$(database)/documents/api_keys/$(uid + '_' + i)); }
      function donorNow()   { return slotAfter('0') || slotAfter('1') || slotAfter('2') || slotAfter('3') || slotAfter('4'); }
      allow read: if true;
      allow create: if signedIn() && me() == uid && incoming().uid == uid
                    && incoming().followers == 0 && incoming().following == 0
                    && (incoming().get('donor', false) == false || donorNow());
      allow update: if signedIn() && (
           // the owner edits the profile; 'followers' is never theirs to write,
           // 'following' only ever moves by one (their own follow action)
           (me() == uid && incoming().uid == uid
              && incoming().followers == existing().followers
              // «🤝 متبرّع»: set only while one of their slots holds a donated key
              && (incoming().get('donor', false) == existing().get('donor', false) || incoming().get('donor', false) == false || donorNow())
              && (incoming().following == existing().following
                  || incoming().following == existing().following + 1
                  || incoming().following == existing().following - 1))
           // someone else's follow / unfollow, in the same batch as the follow doc
        || (bumped('followers', 1)
              && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + uid)) && !exists(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + uid)))
        || (bumped('followers', -1)
              && !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + uid)) && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + uid))));

      match /notifications/{nid} {
        allow read, delete: if signedIn() && me() == uid;
        allow update:       if signedIn() && me() == uid && onlyChanged(['read']);
        // anyone may notify you, but only as themselves
        allow create:       if signedIn() && incoming().actorId == me() && incoming().read == false;
      }
    }
    match /follows/{id} {
      allow read:   if signedIn();
      allow create: if signedIn() && incoming().followerId == me() && incoming().followedId != me()
                    && id == me() + '__' + incoming().followedId;
      allow delete: if signedIn() && existing().followerId == me();
    }

    // ---------------------------------------------------------------- posts · videos · clips · stories
    match /posts/{postId} {
      allow get:  if resource == null || existing().visibility in ['public', 'unlisted'] || isAuthor(existing());
      allow list: if existing().visibility == 'public' || isAuthor(existing());
      allow create: if signedIn() && incoming().authorId == me() && incoming().postId == postId
                    && incoming().likes == 0 && incoming().comments == 0
                    && incoming().views == 0 && incoming().reports == 0
                    && validVis(incoming().visibility)
                    && incoming().kind in ['post', 'video', 'clip', 'story']
                    && incoming().text.size() <= 2000;
      allow update: if signedIn() && (
           (isAuthor(existing()) && incoming().authorId == existing().authorId
              && incoming().likes == existing().likes && incoming().comments == existing().comments
              && incoming().views == existing().views && incoming().reports == existing().reports
              && validVis(incoming().visibility))
        || (bumped('likes', 1)
              && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)) && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
        || (bumped('likes', -1)
              && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)) && exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
        || bumped('comments', 1) || bumped('comments', -1)
        || bumped('views', 1) || bumped('reports', 1));
      allow delete: if isAuthor(existing());

      match /likes/{uid} {
        allow get:            if signedIn() && me() == uid;
        allow create, delete: if signedIn() && me() == uid;
      }
      match /comments/{cid} {
        // comments are as visible as the post they belong to
        allow read: if get(/databases/$(database)/documents/posts/$(postId)).data.visibility in ['public', 'unlisted']
                    || (signedIn() && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == me());
        allow create: if signedIn() && incoming().authorId == me() && incoming().postId == postId
                      && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 800;
        allow delete: if signedIn() && (existing().authorId == me()
                      || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == me());
      }
    }

    // ---------------------------------------------------------------- live (metadata + chat + WebRTC signalling only)
    match /lives/{liveId} {
      allow read: if true;
      allow create: if signedIn() && incoming().hostId == me() && incoming().viewers == 0 && incoming().status == 'live';
      allow update: if signedIn() && (
           (me() == existing().hostId && incoming().hostId == existing().hostId && incoming().viewers == existing().viewers)
        || (bumped('viewers', 1)
              && existsAfter(/databases/$(database)/documents/lives/$(liveId)/viewers/$(request.auth.uid)) && !exists(/databases/$(database)/documents/lives/$(liveId)/viewers/$(request.auth.uid)))
        || (bumped('viewers', -1)
              && !existsAfter(/databases/$(database)/documents/lives/$(liveId)/viewers/$(request.auth.uid)) && exists(/databases/$(database)/documents/lives/$(liveId)/viewers/$(request.auth.uid))));
      allow delete: if signedIn() && me() == existing().hostId;

      match /viewers/{uid} {
        allow read: if true;
        allow create, delete: if signedIn() && me() == uid;
      }
      match /chat/{cid} {
        allow read: if true;
        allow create: if signedIn() && incoming().uid == me() && incoming().text is string && incoming().text.size() <= 300;
      }
      match /signals/{sid} {
        allow read:   if signedIn() && existing().to == me();
        allow create: if signedIn() && incoming().from == me();
      }
    }

    // ---------------------------------------------------------------- passkeys
    // written and read ONLY by the server (netlify/edge-functions/passkeys.js,
    // with the service account); no browser ever touches them
    match /passkeys/{id} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- moderation
    match /reports/{rid} {
      allow create: if signedIn() && incoming().reporterId == me();
      allow read, update, delete: if false;   // handled in the console / Admin SDK
    }
  }
}