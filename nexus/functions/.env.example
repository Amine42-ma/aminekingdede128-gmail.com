# NEXUS · processRequest settings — copy to .env (next to index.js) and edit.
# Nothing here is secret: the donated keys live in Firestore «api_keys».
# POOL_PER_MINUTE=20
# POOL_MAX_TOKENS=2048
# POOL_MAX_TRIES=5
# POOL_TIMEOUT_MS=60000
# POOL_ALLOW_ANONYMOUS=
# POOL_ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
